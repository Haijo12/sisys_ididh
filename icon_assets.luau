--[[
    Roblox Icon Asset IDs
    Maps icon names to Roblox rbxassetid:// values.

    IMPORTANT: Upload the PNG files from icons-pack/ to Roblox Studio
    (View > Asset Manager > Bulk Import), then replace the 0 values
    below with the actual asset IDs Roblox assigns.

    Usage:
        local IconAssets = require(path.to.icon_assets)
        local id = IconAssets.get("arrow-down")           -- defaults to lucide
        local id = IconAssets.get("arrow-down", "lucide") -- explicit pack
        local id = IconAssets.getByPack("material", "add")

    Then use with Astra:
        window:CreateTab({ name = "Home", icon = IconAssets.get("home") })
--]]

