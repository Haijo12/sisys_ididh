-- Get asset ID by name (defaults to lucide pack)
function IconAssets.get(name: string, pack: string?): number?
    pack = pack or "lucide"
    local packTable = IconAssets[pack]
    if not packTable then
        warn("[IconAssets] Unknown pack: " .. pack)
        return nil
    end
    local id = packTable[name]
    if id == 0 then
        warn("[IconAssets] Icon not uploaded yet: " .. name .. " (in " .. pack .. ")")
        return nil
    end
    return id
end

-- Get asset ID by pack and name
function IconAssets.getByPack(pack: string, name: string): number?
    return IconAssets.get(name, pack)
end

-- Convert asset ID to rbxassetid:// string
function IconAssets.resolve(name: string, pack: string?): string
    local id = IconAssets.get(name, pack)
    if not id then return "" end
    return `rbxassetid://{id}`
end

-- List all available packs
function IconAssets.packs(): {string}
    return {"lucide", "material", "tabler", "phosphor", "heroicons", "feather"}
end

return IconAssets
