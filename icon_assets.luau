-- Convert a plain icon name to its pack-prefixed name (e.g. "add" -> "materialAdd")
local function prefixed(pack: string, name: string): string
    local parts = {}
    for part in string.gmatch(name, "[^_-]+") do
        table.insert(parts, part:sub(1, 1):upper() .. part:sub(2))
    end
    return pack .. table.concat(parts)
end

-- Get asset ID by its globally unique pack-prefixed name
function IconAssets.get(name: string): number?
    local id = IconAssets.all[name]
    if id == 0 then
        warn("[IconAssets] Icon not uploaded yet: " .. name)
        return nil
    end
    return id
end

-- Get asset ID by pack and original icon name
function IconAssets.getByPack(pack: string, name: string): number?
    return IconAssets.get(prefixed(pack, name))
end

-- Convert asset ID to rbxassetid:// string
function IconAssets.resolve(name: string): string
    local id = IconAssets.get(name)
    if not id then return "" end
    return `rbxassetid://{id}`
end

-- List all available packs
function IconAssets.packs(): {string}
    return {"lucide", "material", "tabler", "phosphor", "heroicons", "feather"}
end

-- Merged lookup of every icon across all packs (unique, case-sensitive names)
IconAssets.all = {}
for _, pack in ipairs({"lucide", "material", "tabler", "phosphor", "heroicons", "feather"}) do
    for name, id in IconAssets[pack] do
        IconAssets.all[name] = id
    end
end

return IconAssets