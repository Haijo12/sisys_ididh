-- Convert a plain icon name to its pack-prefixed name (e.g. "a-arrow-down" -> "lucideAArrowDown")
local function prefixed(pack: string, name: string): string
    local parts = {}
    for part in string.gmatch(name, "[^_-]+") do
        table.insert(parts, part:sub(1, 1):upper() .. part:sub(2))
    end
    return pack .. table.concat(parts)
end

-- Get icon URL by its globally unique pack-prefixed name
function Icons.get(name: string): string?
    return Icons.all[name]
end

-- Get icon URL by pack and original icon name
function Icons.getByPack(pack: string, name: string): string?
    return Icons.get(prefixed(pack, name))
end

-- List all available icon names in a pack (pack-prefixed names)
function Icons.list(pack: string?): {string}
    pack = pack or "lucide"
    local packTable = Icons[pack]
    if not packTable then return {} end
    local result = {}
    for name in packTable do
        table.insert(result, name)
    end
    table.sort(result)
    return result
end

-- List all available packs
function Icons.packs(): {string}
    return {"lucide", "material", "tabler", "phosphor", "heroicons", "feather"}
end

-- Count icons in a pack
function Icons.count(pack: string?): number
    pack = pack or "lucide"
    local packTable = Icons[pack]
    if not packTable then return 0 end
    local n = 0
    for _ in packTable do
        n += 1
    end
    return n
end

-- Merged lookup of every icon across all packs (unique, case-sensitive names)
Icons.all = {}
for _, pack in ipairs({"lucide", "material", "tabler", "phosphor", "heroicons", "feather"}) do
    for name, url in Icons[pack] do
        Icons.all[name] = url
    end
end

return Icons